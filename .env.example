# --- Mode ---
# When true, gee/* and llm/* return deterministic synthetic data so the demo
# runs fully offline with no GEE or Anthropic credentials.
SYNTHETIC_MODE=true

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT=geosentry@your-gcp-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- ntfy.sh (zero-config push alerts) ---
NTFY_TOPIC=geosentry-demo
NTFY_SERVER=https://ntfy.sh

# --- Twilio (stub only — logs what it would send, no real API calls yet) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Alert gating ---
ALERT_CONFIDENCE_THRESHOLD=0.72

# --- Database ---
DATABASE_URL=sqlite:///./geosentry.db
